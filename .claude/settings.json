{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(source .venv/bin/activate*)",
      "Bash(pytest *)",
      "Bash(python -c *)",
      "Bash(pip install *)",
      "Bash(playwright install *)",
      "Bash(allure *)",
      "Bash(git add *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(code-review-graph *)",
      "Bash(lsof -iTCP -sTCP:LISTEN -P)",
      "Bash(agent-browser --version)",
      "Bash(agent-browser launch *)",
      "Bash(agent-browser --help)",
      "Bash(agent-browser install *)",
      "Bash(agent-browser --cdp * open *)",
      "Bash(agent-browser --cdp * snapshot *)",
      "Bash(agent-browser --cdp * eval *)",
      "Bash(agent-browser --cdp * click *)",
      "Bash(agent-browser --cdp * tab *)",
      "Bash(agent-browser --cdp * batch *)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser eval *)",
      "Bash(agent-browser click *)",
      "Bash(agent-browser tab *)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser batch *)",
      "Bash([ -f *)",
      "Bash([ -d *)",
      "Skill(add-regression-point)",
      "Skill(add-regression-point:*)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m py_compile *)",
      "Bash(.venv/bin/python -m unittest *)",
      "Bash(.venv/bin/pip list*)",
      "Bash(.venv/bin/playwright install *)",
      "Bash(python3 -m unittest discover -s .claude/hooks/gate/tests *)",
      "Bash(python3 .claude/hooks/gate_cli.py --mode audit*)",
      "Bash(agent-browser set viewport *)",
      "Bash(agent-browser --session * open *)",
      "Bash(agent-browser --session * set viewport *)",
      "Bash(agent-browser --session * snapshot *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout .*)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_cli.py\"; [ -f \"$G\" ] || exit 0; python3 \"$G\" --mode write",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_cli.py\"; [ -f \"$G\" ] || exit 0; python3 \"$G\" --mode commit",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "code-review-graph build",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
