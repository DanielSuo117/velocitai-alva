.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
reports/

# ── 本机独有、可能含凭据的配置，禁止入库 ──────────────────────────
# 本机配置（可能填了 API key、指向私人账号的登录态），由 settings.example.py 复制
framework/config/settings.py

# 登录 token 的本地存放处，整个目录都不入库。由 framework/tools/save_auth_state.py
# 人工登录后生成，含：
#   <env>_user.json          Playwright storageState，里面的 authorization cookie（JWT）
#                            就是免登 token，拿到它就等于登进了那个账号；
#   chrome-profile-<env>/    工具启动真实 Chrome 用的独立 profile，同样存着登录会话。
# 不带前导斜杠：无论 settings 把目录指到哪一层，只要叫 .auth 都挡住。
.auth/

# Claude Code 的本地权限决定与私有备忘。不能只靠用户的全局 ignore 挡着 ——
# 换一台机器或别人克隆本仓库时，它们会直接被提交进去。
.claude/settings.local.json
CLAUDE.local.md

# 任何形式的环境变量文件
.env
.env.*
!.env.example

# 自愈写回源码前留下的备份（--self-heal=auto），属本地产物
*.heal-bak

# JetBrains
.idea/

# ── 工具生成、可随时重建的产物 ────────────────────────────────────
# 这几个目录的工具会往自己里面丢一个 .gitignore 来自我屏蔽，但那是工具的
# 实现细节，换版本就可能没有。在仓库这一层显式声明，不依赖它。
.pytest_cache/
.code-review-graph/
.playwright-mcp/
.superpowers/

# Playwright 的 trace / 录像 / 报告默认落点（reports/ 之外的那些）
test-results/
playwright-report/
*.log

# ── iCloud Drive 在文件被驱逐时留下的占位符 ───────────────────────
# 本仓库位于 iCloud Drive 目录下，这类占位符会伪装成真实文件。
*.icloud
